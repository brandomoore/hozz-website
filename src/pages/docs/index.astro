---
/**
 * The documentation index.
 *
 * The competing product's docs root is close to empty, so a new visitor lands
 * on nothing and has to guess. This page instead answers "what am I trying to
 * do" first and lists the sections second.
 */
import DocsLayout from '../../layouts/DocsLayout.astro';
import { type DocPage } from '../../data/docs-nav';

const page: DocPage = {
  href: '/docs/',
  nav: 'Documentation',
  heading: 'Hozz documentation',
  title: 'Hozz beta documentation — downloads, exports and archives',
  description:
    'Set up Hozz, choose a destination, understand its formats, and troubleshoot exports.',
  lede: 'Set up, send, inspect and troubleshoot.',
};

/** The three things people actually arrive wanting. */
const paths = [
  {
    href: '/docs/getting-started/',
    tag: 'Start here',
    title: 'Get the beta',
    body: 'TestFlight, Mac DMG and Android preview.',
  },
  {
    href: '/docs/destinations/',
    tag: 'Destinations',
    title: 'Choose where it goes',
    body: 'Compare all six destinations.',
  },
  {
    href: '/docs/mcp/',
    tag: 'Assistants',
    title: 'Ask questions',
    body: 'Connect an assistant to the read-only MCP server.',
  },
  {
    href: '/docs/delivery-schema/',
    tag: 'Reference',
    title: 'Build a receiver',
    body: 'Read the fields, payloads and headers.',
  },
];
---

<DocsLayout page={page}>
  <p>
    The <a href="/docs/getting-started/#downloads">beta</a> exports Apple Health on iPhone/iPad,
    receives it on Mac, and opens Hozz archives on Android. Export guides cover Apple devices.
  </p>

  <h2>Where to start</h2>

  <ul class="card-grid card-grid--2">
    {
      paths.map((path) => (
        <li>
          <a class="doc-card" href={path.href}>
            <span class="doc-card-tag">{path.tag}</span>
            <h3>{path.title}</h3>
            <p>{path.body}</p>
          </a>
        </li>
      ))
    }
  </ul>

</DocsLayout>
